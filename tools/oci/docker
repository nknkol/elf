def volume_inspect(st, name):
    d = st.volume_dir(name)
    if not (d / 'data').is_dir():
        return None
    meta = store_mod.read_json(d / 'volume.json', {'Name': name})
    return {'Name': name, 'Driver': 'local', 'Mountpoint': str(d / 'data'), 'Scope': 'local',
            'CreatedAt': meta.get('CreatedAt', ''), 'Labels': meta.get('Labels') or {}, 'Options': {}}


def volume_users(st, name):
    return [c for c in st.containers() if any(b[0] == name for b in c['HostConfig']['Binds'])]


def cmd_volume(st, args):
    if not args:
        raise Fail('Usage: docker volume COMMAND (create, inspect, ls, prune, rm)')
    sub, rest = args[0], args[1:]
    if sub == 'create':
        p = parser('volume create')
        p.add_argument('-d', '--driver', default='local')
        p.add_argument('-l', '--label', action='append', default=[])
        p.add_argument('-o', '--opt', action='append', default=[])
        p.add_argument('name', nargs='?')
        a = p.parse_args(rest)
        if a.driver != 'local' or a.opt:
            raise Fail('only the local driver without options is supported')
        import secrets
        name = a.name or secrets.token_hex(32)
        st.create_volume(name, dict(l.partition('=')[::2] for l in a.label))
        print(name)
    elif sub in ('ls', 'list'):
        p = parser('volume ls')
        p.add_argument('-q', '--quiet', action='store_true')
        p.add_argument('--format')
        p.add_argument('-f', '--filter', action='append', default=[])
        a = p.parse_args(rest)
        rows = [{'Driver': 'local', 'Name': n, 'Mountpoint': str(st.volume_dir(n) / 'data')}
                for n in st.volumes()]
        if a.quiet:
            for r in rows:
                print(r['Name'])
        elif not (a.format and fmt.print_formatted(a.format, rows)):
            print(fmt.table([[r['Driver'], r['Name']] for r in rows], ['DRIVER', 'VOLUME NAME']))
    elif sub == 'inspect':
        p = parser('volume inspect')
        p.add_argument('-f', '--format')
        p.add_argument('name', nargs='+')
        a = p.parse_args(rest)
        out = []
        for n in a.name:
            v = volume_inspect(st, n)
            if v is None:
                raise Fail(f'get {n}: no such volume', 1)
            out.append(v)
        if a.format:
            for v in out:
                print(fmt.render(a.format, v))
        else:
            print(json.dumps(out, indent=4))
    elif sub == 'rm':
        p = parser('volume rm')
        p.add_argument('-f', '--force', action='store_true')
        p.add_argument('name', nargs='+')
        a = p.parse_args(rest)
        for n in a.name:
            if volume_inspect(st, n) is None:
                if a.force:
                    continue
                raise Fail(f'get {n}: no such volume', 1)
            users = volume_users(st, n)
            if users:
                raise Fail(f'remove {n}: volume is in use - [{users[0]["Id"]}]', 1)
            store_mod.remove(st.volume_dir(n))
            print(n)
    elif sub == 'prune':
        p = parser('volume prune')
        p.add_argument('-f', '--force', action='store_true')
        p.add_argument('-a', '--all', action='store_true')
        a = p.parse_args(rest)
        confirm(a.force, 'This will remove all local volumes not used by at least one container.')
        freed = 0
        print('Deleted Volumes:')
        for n in st.volumes():
            if not volume_users(st, n) and (a.all or n.startswith('anon-')):
                freed += store_mod.tree_size(st.volume_dir(n))
                store_mod.remove(st.volume_dir(n))
                print(n)
        print(f'\nTotal reclaimed space: {images.human_size(freed)}')
    else:
        raise Fail(f'unknown volume command {sub}')


# ---------------------------------------------------------------- prune
def confirm(force, message):
    if force:
        return
    print(f'WARNING! {message}\nAre you sure you want to continue? [y/N] ', end='', flush=True)
    if sys.stdin.readline().strip().lower() not in ('y', 'yes'):
        raise Fail('aborted', 1)


def prune_containers(st):
    freed, gone = 0, []
    for record in st.containers():
        record = runtime.refresh(st, record)
        if record['State']['Status'] in ('exited', 'created'):
            freed += store_mod.tree_size(st.container_dir(record['Id']))
            runtime.remove(st, record)
            gone.append(record['Id'])
    return gone, freed


def prune_images(st, everything):
    used = {c['Image'] for c in st.containers()}
    freed, gone = 0, []
    for image_id in st.images():
        if image_id in used:
            continue
        if st.image_names(image_id) and not everything:
            continue
        freed += st.image_info(image_id)['info'].get('size', 0)
        for name in st.image_names(image_id):
            st.drop_ref(name)
        store_mod.remove(st.image_dir(image_id))
        gone.append(image_id)
    # Blobs no image refers to any more.
    keep = set()
    for image_id in st.images():
        info = st.image_info(image_id)
        keep.add(info['manifest'].get('config', {}).get('digest', '')[7:])
        keep.update(d[7:] for d in info['info'].get('layer_digests', []))
        keep.add(image_id)
    freed += layer_images.collect(st)
    for blob in (st.home / 'blobs' / 'sha256').iterdir():
        if blob.name not in keep and len(blob.name) == 64:
            try:
                json.loads(blob.read_bytes()) if blob.stat().st_size < (1 << 20) else None
            except ValueError:
                pass
            freed += blob.stat().st_size
            blob.unlink()
    return gone, freed


def cmd_prune(st, kind, args):
    p = parser(f'{kind} prune')
    p.add_argument('-f', '--force', action='store_true')
    p.add_argument('-a', '--all', action='store_true')
    p.add_argument('--volumes', action='store_true')
    p.add_argument('--filter', action='append', default=[])
    a = p.parse_args(args)
    if kind == 'container':
        confirm(a.force, 'This will remove all stopped containers.')
        gone, freed = prune_containers(st)
        if gone:
            print('Deleted Containers:\n' + '\n'.join(gone) + '\n')
    elif kind == 'image':
        confirm(a.force, 'This will remove all images without at least one container associated to them.'
                if a.all else 'This will remove all dangling images.')
        gone, freed = prune_images(st, a.all)
        if gone:
            print('Deleted Images:\n' + '\n'.join('deleted: sha256:' + g for g in gone) + '\n')
    elif kind == 'builder':
        confirm(a.force, 'This will remove all dangling build cache.')
        freed = store_mod.tree_size(st.home / 'build-cache')
        store_mod.remove(st.home / 'build-cache')
        (st.home / 'build-cache').mkdir()
    else:   # system
        confirm(a.force, 'This will remove:\n  - all stopped containers\n  - all '
                + ('images without at least one container associated to them' if a.all else 'dangling images')
                + '\n  - all build cache')
        _, f1 = prune_containers(st)
        _, f2 = prune_images(st, a.all)
        f3 = store_mod.tree_size(st.home / 'build-cache')
        store_mod.remove(st.home / 'build-cache')
        (st.home / 'build-cache').mkdir()
        freed = f1 + f2 + f3
        if a.volumes:
            for n in st.volumes():
                if not volume_users(st, n):
                    freed += store_mod.tree_size(st.volume_dir(n))
                    store_mod.remove(st.volume_dir(n))
    print(f'Total reclaimed space: {images.human_size(freed)}')


# ---------------------------------------------------------------- networks
def cmd_network(st, args):
    if not args:
        raise Fail('Usage: docker network COMMAND (connect, create, disconnect, inspect, ls, prune, rm)')
    sub, rest = args[0], args[1:]
    if sub == 'create':
        p = parser('network create')
        p.add_argument('-d', '--driver', default='bridge')
        p.add_argument('--label', action='append', default=[])
        p.add_argument('--internal', action='store_true')
        p.add_argument('--attachable', action='store_true')
        p.add_argument('-o', '--opt', action='append', default=[])
        p.add_argument('--subnet', action='append', default=[])
        p.add_argument('name')
        a = p.parse_args(rest)
        if a.subnet:
            raise Fail('--subnet is not supported: container addresses come from 127.128.0.0/9')
        spec = network.create(st, a.name, a.driver, dict(l.partition('=')[::2] for l in a.label),
                              a.internal, a.attachable, dict(o.partition('=')[::2] for o in a.opt))
        print(spec['Id'])
    elif sub in ('ls', 'list'):
        p = parser('network ls')
        p.add_argument('-q', '--quiet', action='store_true')
        p.add_argument('--no-trunc', action='store_true')
        p.add_argument('--format')
        p.add_argument('-f', '--filter', action='append', default=[])
        a = p.parse_args(rest)
        rows = []
        for n in network.networks(st).values():
            rows.append({'ID': n['Id'] if a.no_trunc else n['Id'][:12], 'Name': n['Name'],
                         'Driver': n['Driver'], 'Scope': 'local', 'Labels': n.get('Labels') or {}})
        for f in a.filter:
            key, _, value = f.partition('=')
            if key == 'name':
                rows = [r for r in rows if value in r['Name']]
            elif key == 'label':
                k, _, v = value.partition('=')
                rows = [r for r in rows if k in r['Labels'] and (not v or r['Labels'][k] == v)]
            elif key == 'driver':
                rows = [r for r in rows if r['Driver'] == value]
        if a.quiet:
            for r in rows:
                print(r['ID'])
        elif not (a.format and fmt.print_formatted(a.format, rows)):
            print(fmt.table([[r['ID'], r['Name'], r['Driver'], r['Scope']] for r in rows],
                            ['NETWORK ID', 'NAME', 'DRIVER', 'SCOPE']))
    elif sub == 'inspect':
        p = parser('network inspect')
        p.add_argument('-f', '--format')
        p.add_argument('name', nargs='+')
        a = p.parse_args(rest)
        out = [network.inspect(st, n) for n in a.name]
        if a.format:
            for n in out:
                print(fmt.render(a.format, n))
        else:
            print(json.dumps(out, indent=4))
    elif sub == 'rm' or sub == 'remove':
        p = parser('network rm')
        p.add_argument('-f', '--force', action='store_true')
        p.add_argument('name', nargs='+')
        a = p.parse_args(rest)
        for n in a.name:
            print(network.remove(st, n)['Name'])
    elif sub == 'connect':
        p = parser('network connect')
        p.add_argument('--alias', action='append', default=[])
        p.add_argument('--ip')
        p.add_argument('network')
        p.add_argument('container')
        a = p.parse_args(rest)
        network.connect(st, st.resolve_container(a.container), a.network, a.alias)
    elif sub == 'disconnect':
        p = parser('network disconnect')
        p.add_argument('-f', '--force', action='store_true')
        p.add_argument('network')
        p.add_argument('container')
        a = p.parse_args(rest)
        network.disconnect(st, st.resolve_container(a.container), a.network)
    elif sub == 'prune':
        p = parser('network prune')
        p.add_argument('-f', '--force', action='store_true')
        p.add_argument('--filter', action='append', default=[])
        a = p.parse_args(rest)
        confirm(a.force, 'This will remove all custom networks not used by at least one container.')
        gone = []
        for n in list(network.networks(st).values()):
            if n['Name'] not in network.BUILTIN and not network.users(st, n['Name']):
                network.remove(st, n['Name'])
                gone.append(n['Name'])
        if gone:
            print('Deleted Networks:\n' + '\n'.join(gone))
    else:
        raise Fail(f'docker network {sub}: unknown command')


def cmd_port(st, args):
    p = parser('port', 'List port mappings or a specific mapping for the container')
    p.add_argument('container')
    p.add_argument('port', nargs='?')
    a = p.parse_args(args)
    record = runtime.refresh(st, st.resolve_container(a.container))
    ports = network_settings(st, record)['Ports']
    want = a.port and (a.port if '/' in a.port else a.port + '/tcp')
    found = False
    for key, bindings in ports.items():
        if want and key != want:
            continue
        for b in bindings or []:
            found = True
            print(f'{b["HostIp"]}:{b["HostPort"]}' if want else f'{key} -> {b["HostIp"]}:{b["HostPort"]}')
    if want and not found:
        raise Fail(f'no public port \'{a.port}\' published for {record["Name"]}')


# ---------------------------------------------------------------- registry auth
def cmd_login(st, args):
    p = parser('login', 'Log in to a registry')
    p.add_argument('-u', '--username')
    p.add_argument('-p', '--password')
    p.add_argument('--password-stdin', action='store_true')
    p.add_argument('server', nargs='?', default=registry.DOCKER_HUB)
    a = p.parse_args(args)
    user = a.username or input('Username: ')
    if a.password_stdin:
        password = sys.stdin.read().strip()
    else:
        import getpass
        password = a.password or getpass.getpass('Password: ')
    server = a.server.replace('https://', '').rstrip('/')
    if server in ('index.docker.io/v1', 'index.docker.io', 'registry-1.docker.io'):
        server = registry.DOCKER_HUB
    ref = registry.Reference(f'{server}/library/x' if server != registry.DOCKER_HUB else 'x')
    client = registry.Client(ref, auth=(user, password))
    client.ping()
    registry.store_credentials(server, user, password)
    print('Login Succeeded')


def cmd_logout(st, args):
    server = (args[0] if args else registry.DOCKER_HUB).replace('https://', '').rstrip('/')
    if registry.remove_credentials(server):
        print(f'Removing login credentials for {server}')
    else:
        print(f'Not logged in to {server}')


