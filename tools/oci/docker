ERRORS = (store_mod.StoreError, registry.RegistryError, unpack.UnpackError,
          runspec.SpecError, OSError, ValueError)


class Fail(Exception):
    def __init__(self, message, code=125):
        super().__init__(message)
        self.code = code


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Fail(f'{self.prog}: {message}\nSee \'{self.prog} --help\'.')


def parser(prog, description=None, add_help=True):
    p = Parser(prog=f'docker {prog}', description=description, allow_abbrev=False, add_help=add_help)
    if not add_help:
        p.add_argument('--help', action='help')
    return p


# ---------------------------------------------------------------- images
def image_names(st, image_id):
    out = []
    for name in st.image_names(image_id):
        repo, _, tag = name.rpartition(':')
        out.append((registry.short_name(repo), tag))
    return out


def image_inspect(st, image_id):
    info = st.image_info(image_id)
    config = info['config']
    return {
        'Id': 'sha256:' + image_id,
        'RepoTags': [f'{r}:{t}' for r, t in image_names(st, image_id)],
        'RepoDigests': [registry.short_name(d.split('@')[0]) + '@' + d.split('@')[1]
                        for d in info['info'].get('repo_digests', [])],
        'Created': config.get('created', ''),
        'Author': config.get('author', ''),
        'Config': config.get('config', {}),
        'Architecture': config.get('architecture'),
        'Variant': config.get('variant', ''),
        'Os': config.get('os'),
        'Size': info['info'].get('size', 0),
        'GraphDriver': {'Name': 'elf-unpacked',
                        'Data': dict({'Rootfs': '' if info['info'].get('pruned') else
                                      str(st.image_dir(image_id) / 'rootfs')},
                                     **({'LayerImages': ':'.join(str(i) for _, i in stack)}
                                        if (stack := layer_images.stack_entries(st, image_id)) else {}))},
        'RootFS': {'Type': 'layers', 'Layers': config.get('rootfs', {}).get('diff_ids', [])},
        'Metadata': {'LastTagTime': info['info'].get('created', ''),
                     'Dirty': bool(info['info'].get('dirty'))},
    }


def ensure_image(st, text, pull_policy='missing', quiet=False):
    if pull_policy != 'always':
        try:
            return st.resolve_image(text)
        except store_mod.StoreError:
            if pull_policy == 'never':
                raise
    if not quiet:
        print(f"Unable to find image '{text}' locally", file=sys.stderr)
    return images.pull(st, text, mirror=os.environ.get('ELF_OCI_MIRROR'), quiet=quiet)


def cmd_pull(st, args):
    p = parser('pull', 'Download an image from a registry')
    p.add_argument('-q', '--quiet', action='store_true')
    p.add_argument('--platform')
    p.add_argument('--registry-mirror', default=os.environ.get('ELF_OCI_MIRROR'))
    p.add_argument('-a', '--all-tags', action='store_true')
    p.add_argument('name')
    a = p.parse_args(args)
    if a.platform and a.platform not in ('linux/arm64', 'linux/arm64/v8'):
        raise Fail(f'only linux/arm64 images can run here, not {a.platform}')
    if a.all_tags:
        raise Fail('--all-tags is not supported')
    images.pull(st, a.name, mirror=a.registry_mirror, quiet=a.quiet)
    print(registry.Reference(a.name).full)


def cmd_load(st, args):
    p = parser('load', 'Load an image from a tar archive or STDIN')
    p.add_argument('-i', '--input')
    p.add_argument('-q', '--quiet', action='store_true')
    a = p.parse_args(args)
    source = a.input
    if not source:
        if sys.stdin.isatty():
            raise Fail('requested load from stdin, but stdin is empty')
        tmp = st.home / 'tmp' / f'stdin-{os.getpid()}.tar'
        with open(tmp, 'wb') as f:
            import shutil
            shutil.copyfileobj(sys.stdin.buffer, f)
        source = tmp
    try:
        for image_id, names in images.load(st, source, quiet=True):
            for name in names:
                repo, _, tag = name.rpartition(':')
                print(f'Loaded image: {registry.short_name(repo)}:{tag}')
            if not names:
                print(f'Loaded image ID: sha256:{image_id}')
    finally:
        if not a.input:
            Path(source).unlink(missing_ok=True)


def cmd_save(st, args):
    p = parser('save', 'Save one or more images to a tar archive')
    p.add_argument('-o', '--output')
    p.add_argument('image', nargs='+')
    a = p.parse_args(args)
    chosen = []
    for text in a.image:
        image_id = st.resolve_image(text)
        try:
            ref = registry.Reference(text)
            names = [ref.full] if ref.full in st.refs() else []
        except registry.RegistryError:
            names = []
        chosen.append((image_id, names))
    if a.output:
        with open(a.output, 'wb') as out:
            images.save(st, chosen, out)
    else:
        if sys.stdout.isatty():
            raise Fail('cowardly refusing to save to a terminal. Use the -o flag or redirect')
        images.save(st, chosen, sys.stdout.buffer)


def cmd_images(st, args):
    p = parser('images', 'List images')
    p.add_argument('-a', '--all', action='store_true')
    p.add_argument('-q', '--quiet', action='store_true')
    p.add_argument('--digests', action='store_true')
    p.add_argument('--no-trunc', action='store_true')
    p.add_argument('--format')
    p.add_argument('-f', '--filter', action='append', default=[])
    p.add_argument('repository', nargs='?')
    a = p.parse_args(args)
    filters = dict(f.split('=', 1) for f in a.filter)
    rows = []
    for image_id in st.images():
        info = st.image_info(image_id)
        names = image_names(st, image_id) or [('<none>', '<none>')]
        if filters.get('dangling') == 'true' and names[0][0] != '<none>':
            continue
        if filters.get('dangling') == 'false' and names[0][0] == '<none>':
            continue
        for repo, tag in names:
            if a.repository:
                want_repo, _, want_tag = a.repository.partition(':')
                if repo != want_repo or (want_tag and tag != want_tag):
                    continue
            digests = info['info'].get('repo_digests', [])
            rows.append({
                'Repository': repo, 'Tag': tag,
                'ID': ('sha256:' + image_id) if a.no_trunc else image_id[:12],
                'Digest': digests[0].split('@')[1] if digests else '<none>',
                'CreatedAt': info['config'].get('created', ''),
                'CreatedSince': fmt.ago(info['config'].get('created', '')),
                'Size': images.human_size(info['info'].get('size', 0)),
                'Dirty': 'yes' if info['info'].get('dirty') else ''})
    if a.quiet:
        for r in dict.fromkeys(r['ID'] for r in rows):
            print(r)
        return
    if a.format and fmt.print_formatted(a.format, rows):
        return
    cols = ['REPOSITORY', 'TAG'] + (['DIGEST'] if a.digests else []) + ['IMAGE ID', 'CREATED', 'SIZE']
    out = []
    for r in rows:
        line = [r['Repository'], r['Tag']] + ([r['Digest']] if a.digests else [])
        size = r['Size'] + (' (modified in place)' if r['Dirty'] else '')
        out.append(line + [r['ID'], r['CreatedSince'], size])
    print(fmt.table(out, cols))


def cmd_rmi(st, args):
    p = parser('rmi', 'Remove one or more images')
    p.add_argument('-f', '--force', action='store_true')
    p.add_argument('--no-prune', action='store_true')
    p.add_argument('image', nargs='+')
    a = p.parse_args(args)
    status = 0
    for text in a.image:
        try:
            remove_image(st, text, a.force)
        except ERRORS as e:
            print(f'Error response from daemon: {e}', file=sys.stderr)
            status = 1
    return status


def remove_image(st, text, force=False):
    image_id = st.resolve_image(text)
    names = st.image_names(image_id)
    by_name = None
    try:
        ref = registry.Reference(text)
        if ref.full in names:
            by_name = ref.full
    except registry.RegistryError:
        pass
    if by_name and len(names) > 1:
        st.drop_ref(by_name)
        print(f'Untagged: {text}')
        return
    if not by_name and len(names) > 1 and not force:
        raise store_mod.StoreError(f'conflict: unable to delete {image_id[:12]} (must be forced) - '
                                   'image is referenced in multiple repositories')
    users = [c for c in st.containers() if c['Image'] == image_id]
    if users and not force:
        raise store_mod.StoreError(f'conflict: unable to remove repository reference "{text}" '
                                   f'(must force) - container {users[0]["Id"][:12]} is using its '
                                   'referenced image')
    for name in names:
        st.drop_ref(name)
        repo, _, tag = name.rpartition(':')
        print(f'Untagged: {registry.short_name(repo)}:{tag}')
    if users:
        return  # Forced with containers: only the names go (as Docker).
    target = st.image_dir(image_id)
    trash = st.home / 'tmp' / f'rmi-{image_id}'
    with st.lock():
        target.rename(trash)
    store_mod.remove(trash)
    layer_images.collect(st)  # layer images no other image shares (R6)
    print(f'Deleted: sha256:{image_id}')


def cmd_image_erofs(st, args):
    p = parser('image erofs', 'Keep the layers of images as erofs layer images (R6): --cow containers '
               'then run on them, expanded on demand, and layers images share are stored once')
    p.add_argument('--prune', action='store_true',
                   help='drop the unpacked rootfs afterwards (unpacked again when a command needs it)')
    p.add_argument('image', nargs='+')
    a = p.parse_args(args)
    for text in a.image:
        image_id = st.resolve_image(text)
        entries = layer_images.convert(st, image_id, quiet=False)
        line = f'{image_id[:12]}: {len(entries)} layer image{"s" if len(entries) != 1 else ""}'
        if a.prune:
            freed = layer_images.prune_rootfs(st, image_id)
            line += f', unpacked rootfs removed ({freed // 1000000} MB)'
        print(line)


def cmd_tag(st, args):
    p = parser('tag', 'Create a tag TARGET_IMAGE that refers to SOURCE_IMAGE')
    p.add_argument('source')
    p.add_argument('target')
    a = p.parse_args(args)
    image_id = st.resolve_image(a.source)
    ref = registry.Reference(a.target)
    if ref.digest:
        raise Fail('refusing to create a tag with a digest reference')
    st.set_ref(ref.full, image_id)


def cmd_history(st, args):
    p = parser('history', 'Show the history of an image')
    p.add_argument('-q', '--quiet', action='store_true')
    p.add_argument('--no-trunc', action='store_true')
    p.add_argument('-H', '--human', default='true')
    p.add_argument('--format')
    p.add_argument('image')
    a = p.parse_args(args)
    image_id = st.resolve_image(a.image)
    info = st.image_info(image_id)
    history = info['config'].get('history', [])
    rows = []
    for i, h in enumerate(reversed(history)):
        created_by = h.get('created_by', '')
        if not a.no_trunc and len(created_by) > 45:
            created_by = created_by[:44] + '…'
        rows.append({'ID': (image_id[:12] if i == 0 else '<missing>'),
                     'CreatedSince': fmt.ago(h.get('created', '')), 'CreatedAt': h.get('created', ''),
                     'CreatedBy': created_by, 'Size': '0B' if h.get('empty_layer') else '-',
                     'Comment': h.get('comment', '')})
    if a.quiet:
        print(image_id[:12])
        return
    if a.format and fmt.print_formatted(a.format, rows):
        return
    print(fmt.table([[r['ID'], r['CreatedSince'], r['CreatedBy'], r['Size'], r['Comment']]
                     for r in rows], ['IMAGE', 'CREATED', 'CREATED BY', 'SIZE', 'COMMENT']))


# ---------------------------------------------------------------- containers
def parse_volume(text, anonymous_ok=True):
    """-v HOST:GUEST[:ro|rw], NAME:GUEST[:opts], or GUEST (anonymous)."""
    parts = text.split(':')
    mode = 'rw'
    if len(parts) == 3:
        opts = parts[2].split(',')
        mode = 'ro' if 'ro' in opts or 'readonly' in opts else 'rw'
        parts = parts[:2]
    if len(parts) == 1:
        if not anonymous_ok:
            raise Fail(f'invalid volume specification: {text}')
        return None, parts[0], mode
    src, dst = parts
    if not dst.startswith('/'):
        raise Fail(f'invalid volume specification: {text}: the container path must be absolute')
    if src.startswith(('/', '~', '.')):
        src = os.path.abspath(os.path.expanduser(src))
        if not os.path.exists(src):
            os.makedirs(src)   # Docker creates a missing bind source directory.
    elif not all(c.isalnum() or c in '_.-' for c in src):
        raise Fail(f'invalid volume name {src}')
    return src, dst, mode


def parse_mount(text):
    fields = {}
    for item in text.split(','):
        key, _, value = item.partition('=')
        fields[key] = value if value else 'true'
    kind = fields.get('type', 'volume')
    src = fields.get('source') or fields.get('src')
    dst = fields.get('target') or fields.get('destination') or fields.get('dst')
    readonly = fields.get('readonly', fields.get('ro', 'false')) in ('true', '1')
    if not dst:
        raise Fail(f'invalid mount {text}: no target')
    if kind == 'bind':
        if not src or not os.path.exists(src):
            raise Fail(f'invalid mount config for type "bind": bind source path does not exist: {src}')
        return ('bind', os.path.abspath(src), dst, 'ro' if readonly else 'rw')
    if kind == 'volume':
        return ('volume', src, dst, 'ro' if readonly else 'rw')
    if kind == 'tmpfs':
        return ('tmpfs', None, dst, 'rw')
    raise Fail(f'mount type {kind} is not supported')


def parse_env_file(path):
    """Docker's rules: '#' lines and blank lines skipped; KEY alone takes the
    host value (dropped if unset); no quote or shell processing."""
    out = []
    for line in Path(path).read_text().splitlines():
        stripped = line.lstrip()
        if not stripped or stripped.startswith('#'):
            continue
        if '=' in stripped:
            key, _, value = stripped.partition('=')
            if not key or any(c.isspace() for c in key):
                raise Fail(f'invalid environment variable: {line}')
            out.append(f'{key}={value}')
        elif stripped in os.environ:
            out.append(f'{stripped}={os.environ[stripped]}')
    return out


def env_entries(items):
    out = []
    for item in items:
        if '=' in item:
            out.append(item)
        elif item in os.environ:
            out.append(f'{item}={os.environ[item]}')
    return out


