def cmd_start(st, args):
    p = parser('start', 'Start one or more stopped containers')
    p.add_argument('-a', '--attach', action='store_true')
    p.add_argument('-i', '--interactive', action='store_true')
    p.add_argument('container', nargs='+')
    a = p.parse_args(args)
    if (a.attach or a.interactive) and len(a.container) > 1:
        raise Fail('you cannot start and attach multiple containers at once')
    for text in a.container:
        record = runtime.refresh(st, st.resolve_container(text))
        if record['State']['Status'] in ('running', 'restarting'):
            if not a.attach:
                print(text)
            continue
        if a.attach or a.interactive:
            return runtime.start_foreground(st, record, a.interactive, record['Config'].get('Tty'))
        runtime.start_detached(st, record)
        print(text)
    return 0


