def group(kind, table):
    def handler(st, args):
        if not args or args[0] not in table:
            raise Fail(f'Usage: docker {kind} COMMAND ({", ".join(sorted(table))})')
        return table[args[0]](st, args[1:])
    return handler


def build_commands(st, args, name):
    import build
    return getattr(build, 'cmd_' + name)(st, args)


