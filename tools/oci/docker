def status_text(record):
    state = record['State']
    s = state['Status']
    if s == 'running':
        return 'Up ' + fmt.human_duration(__import__('time').time() - fmt.parse_time(state['StartedAt']))
    if s == 'restarting':
        return f'Restarting ({state.get("ExitCode") or 0}) {fmt.ago(state.get("FinishedAt"))}'
    if s == 'exited':
        return f'Exited ({state.get("ExitCode")}) {fmt.ago(state.get("FinishedAt"))}'
    return 'Created'


def container_row(st, record, no_trunc=False):
    cfg = record['Config']
    command = ' '.join(shlex.quote(c) for c in (cfg.get('Entrypoint') or []) + (cfg.get('Cmd') or []))
    if not no_trunc and len(command) > 20:
        command = command[:19] + '…'
    image = record['ImageName']
    return {'ID': record['Id'] if no_trunc else record['Id'][:12], 'Image': image,
            'Command': f'"{command}"', 'CreatedAt': record['Created'],
            'RunningFor': fmt.ago(record['Created']), 'Status': status_text(record),
            'State': record['State']['Status'], 'Ports': network.describe_ports(record),
            'Names': record['Name'], 'Labels': ','.join(f'{k}={v}' for k, v in (cfg.get('Labels') or {}).items()),
            'Mounts': ','.join(b[1] for b in record['HostConfig']['Binds'])}


def cmd_ps(st, args):
    p = parser('ps', 'List containers')
    p.add_argument('-a', '--all', action='store_true')
    p.add_argument('-q', '--quiet', action='store_true')
    p.add_argument('-l', '--latest', action='store_true')
    p.add_argument('-n', '--last', type=int)
    p.add_argument('-s', '--size', action='store_true')
    p.add_argument('--no-trunc', action='store_true')
    p.add_argument('--format')
    p.add_argument('-f', '--filter', action='append', default=[])
    a = p.parse_args(args)
    records = [runtime.refresh(st, r) for r in st.containers()]
    if a.latest:
        records = records[:1]
    elif a.last:
        records = records[:a.last]
    elif not a.all:
        records = [r for r in records if r['State']['Status'] in ('running', 'restarting')]
    for f in a.filter:
        key, _, value = f.partition('=')
        if key == 'status':
            records = [r for r in records if r['State']['Status'] == value]
        elif key == 'name':
            records = [r for r in records if value in r['Name']]
        elif key == 'id':
            records = [r for r in records if r['Id'].startswith(value)]
        elif key == 'label':
            k, _, v = value.partition('=')
            records = [r for r in records if k in (r['Config'].get('Labels') or {}) and
                       (not v or r['Config']['Labels'][k] == v)]
        elif key == 'ancestor':
            try:
                image_id = st.resolve_image(value)
            except store_mod.StoreError:
                image_id = None
            records = [r for r in records if r['Image'] == image_id]
        elif key == 'exited':
            records = [r for r in records if r['State']['Status'] == 'exited' and
                       str(r['State'].get('ExitCode')) == value]
        else:
            raise Fail(f'invalid filter {key}')
    rows = [container_row(st, r, a.no_trunc) for r in records]
    if a.quiet:
        for r in rows:
            print(r['ID'])
        return
    if a.format and fmt.print_formatted(a.format, rows):
        return
    print(fmt.table([[r['ID'], r['Image'], r['Command'], r['RunningFor'], r['Status'], r['Ports'],
                      r['Names']] for r in rows],
                    ['CONTAINER ID', 'IMAGE', 'COMMAND', 'CREATED', 'STATUS', 'PORTS', 'NAMES']))


def container_inspect(st, record):
    record = runtime.refresh(st, record)
    cfg, host, state = record['Config'], record['HostConfig'], record['State']
    command = (cfg.get('Entrypoint') or []) + (cfg.get('Cmd') or [])
    return {
        'Id': record['Id'], 'Created': record['Created'],
        'Path': command[0] if command else '', 'Args': command[1:],
        'State': {'Status': state['Status'], 'Running': state['Status'] == 'running',
                  'Paused': False, 'Restarting': state['Status'] == 'restarting', 'OOMKilled': False,
                  'Dead': False, 'Pid': state.get('Pid') or 0, 'ExitCode': state.get('ExitCode') or 0,
                  'Error': '', 'StartedAt': state.get('StartedAt') or '0001-01-01T00:00:00Z',
                  'FinishedAt': state.get('FinishedAt') or '0001-01-01T00:00:00Z'},
        'Image': 'sha256:' + record['Image'], 'Name': '/' + record['Name'],
        'RestartCount': state.get('RestartCount', 0),
        'Driver': 'elf-copy' if not (host.get('ReadonlyRootfs') or host.get('InPlace')) else 'elf-image',
        'Platform': 'linux',
        'HostConfig': {'Binds': [f'{s}:{d}' + (':ro' if m == 'ro' else '') for s, d, m in host['Binds']],
                       'AutoRemove': host.get('AutoRemove', False), 'NetworkMode': network.mode(record),
                       'PortBindings': host.get('PortBindings') or [],
                       'ReadonlyRootfs': host.get('ReadonlyRootfs', False),
                       'RestartPolicy': host.get('RestartPolicy'), 'Tmpfs': {t: '' for t in host.get('Tmpfs') or []},
                       'ExtraHosts': [f'{n}:{i}' for n, i in host.get('ExtraHosts') or []],
                       'Dns': host.get('Dns') or [], 'Isolate': host.get('Isolate', False)},
        'GraphDriver': {'Name': 'elf', 'Data': dict(
            {'Rootfs': str(runtime.rootfs_of(st, record))},
            **({'UpperDir': str(runtime.rootfs_of(st, record)),
                'LowerDir': str(runtime.lower_of(st, record))}
               if record['HostConfig'].get('Cow') else {}),
            **({'LayerImages': ':'.join(i for _, i in record['HostConfig']['LayerImages'])}
               if record['HostConfig'].get('LayerImages') else {}))},
        'Mounts': [{'Type': 'bind' if s.startswith('/') else 'volume', 'Source': s if s.startswith('/') else
                    str(st.volume_dir(s) / 'data'), 'Name': '' if s.startswith('/') else s,
                    'Destination': d, 'Mode': m, 'RW': m != 'ro'} for s, d, m in host['Binds']],
        'Config': {'Hostname': cfg['Hostname'], 'User': cfg.get('User', ''), 'Tty': cfg.get('Tty', False),
                   'OpenStdin': cfg.get('OpenStdin', False), 'Env': cfg.get('Env', []),
                   'Cmd': cfg.get('Cmd'), 'Image': record['ImageName'], 'WorkingDir': cfg.get('WorkingDir', ''),
                   'Entrypoint': cfg.get('Entrypoint'), 'Labels': cfg.get('Labels', {}),
                   'StopSignal': cfg.get('StopSignal'), 'ExposedPorts': cfg.get('ExposedPorts', {}),
                   'Volumes': cfg.get('Volumes', {})},
        'NetworkSettings': network_settings(st, record),
    }


def network_settings(st, record):
    ip = network.address(st, record)
    nets = (record.get('NetworkSettings') or {}).get('Networks') or {}
    m = network.mode(record)
    if m in ('host', 'none'):
        nets = {m: {}}
    out_nets = {}
    for name, n in nets.items():
        out_nets[name] = {'IPAddress': ip if name not in ('host', 'none') else '', 'IPPrefixLen': 9 if ip else 0,
                          'Gateway': '', 'Aliases': n.get('Aliases') or None, 'NetworkID': n.get('NetworkID', name),
                          'MacAddress': '', 'EndpointID': record['Id'][:32] if ip else ''}
    running = record['State']['Status'] in ('running', 'restarting')
    return {'IPAddress': ip, 'IPPrefixLen': 9 if ip else 0, 'Gateway': '', 'MacAddress': '',
            'Ports': ((record.get('NetworkSettings') or {}).get('Ports') or {}) if running else {},
            'Networks': out_nets}


