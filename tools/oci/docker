#!/usr/bin/env python3
"""Docker-compatible command for OCI images on the ELF loader (docs/OCI.md).

Images are unpacked rootfs trees; containers run under elfloader (PRoot
semantics, optionally --isolate). No daemon, no namespaces: see docs/OCI.md
for what is and is not supported. Exit codes: 125 for errors of this
command, 126/127 when the container command cannot run or is missing,
otherwise the container's own status."""
import argparse
import json
import os
import shlex
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.modules.setdefault('docker_cli', sys.modules[__name__])   # For build.py.
import fmt  # noqa: E402
import images  # noqa: E402
import layer_images  # noqa: E402
import network  # noqa: E402
