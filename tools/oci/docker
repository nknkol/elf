def check_unsupported(args):
    for arg in args:
        if not arg.startswith('-'):
            break
        name = arg.split('=', 1)[0]
        if name in UNSUPPORTED:
            raise Fail(f'{name} is not supported: {UNSUPPORTED[name]}')


def split_options(args, takes_value=None):
    """(options, image or container, command): options end at the first
    non-option; everything after the image belongs to the command."""
    takes_value = takes_value or {'--name', '-e', '--env', '--env-file', '-v', '--volume', '--mount', '--tmpfs',
                   '-w', '--workdir', '-u', '--user', '-h', '--hostname', '--entrypoint', '-p',
                   '--publish', '--expose', '--network', '--net', '--network-alias', '--net-alias',
                   '--ip', '--add-host', '--dns', '-l',
                   '--label', '--restart', '--stop-signal', '--stop-timeout', '--pull',
                   '--platform', '--isolate-device', '-a', '--attach', '--sig-proxy',
                   '--log-driver', '--cidfile'}
    i = 0
    while i < len(args):
        a = args[i]
        if a == '--' or not a.startswith('-') or a == '-':
            break
        if a in takes_value:
            i += 1
        i += 1
    options, rest = args[:i], args[i:]
    if rest and rest[0] == '--':
        rest = rest[1:]
    if not rest:
        return options, None, []
    return options, rest[0], rest[1:]


def new_record(st, a, image_id, image_text):
    config = st.image_info(image_id)['config'].get('config', {})
    if a.platform and a.platform not in ('linux/arm64', 'linux/arm64/v8'):
        raise Fail(f'only linux/arm64 images can run here, not {a.platform}')
    if a.read_only and a.in_place:
        raise Fail('--read-only and --in-place exclude each other')
    if a.cow and (a.read_only or a.in_place):
        raise Fail('--cow excludes --read-only and --in-place')
    if a.isolate:
        import engine
        engine.socket_guard(st, [v.split(':')[0] for v in a.volume] +
                            [parse_mount(m)[1] or '' for m in a.mount], True)
    publish = list(a.publish)
    if a.network == 'host':
        for spec in publish:
            ports = spec.split('/')[0].split(':')
            if len(ports) < 2 or ports[-1] != ports[-2]:
                raise Fail(f'-p {spec}: with --network host a port is published only as itself '
                           '(-p N:N: the program listens on host port N)')
    else:
        if a.publish_all:
            # -P: every exposed TCP port on a free host port.
            for key in list(config.get('ExposedPorts') or {}) + list(a.expose):
                port, _, proto = str(key).partition('/')
                if (proto or 'tcp') == 'tcp':
                    publish.append(port)
        for spec in publish:
            network.parse_publish(spec)
    cid = st.new_id()
    entrypoint = config.get('Entrypoint')
    cmd = config.get('Cmd')
    if a.entrypoint is not None:
        entrypoint = shlex.split(a.entrypoint) if a.entrypoint else []
        cmd = None
    if a.command:
        cmd = a.command
    env = list(config.get('Env') or [])
    for path in a.env_file:
        env += parse_env_file(path)
    env += env_entries(a.env)
    binds = []
    tmpfs = list(a.tmpfs)
    for v in a.volume:
        src, dst, mode = parse_volume(v)
        if src is None:
            src = f'anon-{cid[:12]}-{len(binds)}'
        binds.append([src, dst, mode])
    for m in a.mount:
        kind, src, dst, mode = parse_mount(m)
        if kind == 'tmpfs':
            tmpfs.append(dst)
        else:
            binds.append([src or f'anon-{cid[:12]}-{len(binds)}', dst, mode])
    if (a.read_only or any(b[2] == 'ro' for b in binds)) and not Path(runspec.BUILD / 'elfloader-guarded').exists() \
            and not os.environ.get('ELF_LOADER_GUARDED'):
        raise Fail('read-only volumes need the guarded loader build (make build)')
    restart = {'Name': 'no', 'MaximumRetryCount': 0}
    if a.restart:
        name, _, count = a.restart.partition(':')
        if name not in ('no', 'always', 'unless-stopped', 'on-failure'):
            raise Fail(f'invalid restart policy {a.restart}')
        restart = {'Name': name, 'MaximumRetryCount': int(count or 0)}
        if a.rm and name != 'no':
            raise Fail('conflicting options: --restart and --rm')
    hosts = []
    for item in a.add_host:
        name, _, ip = item.partition(':') if '=' not in item else item.partition('=')
        hosts.append([name, ('127.0.0.1' if a.network == 'host' else network.HOST_ALIAS)
                      if ip == 'host-gateway' else ip])
    labels = dict(config.get('Labels') or {})
    for item in a.label:
        key, _, value = item.partition('=')
        labels[key] = value
    name = a.name or random_name(st)
    if not all(c.isalnum() or c in '_.-' for c in name):
        raise Fail(f'Invalid container name ({name}), only [a-zA-Z0-9][a-zA-Z0-9_.-] are allowed')
    record = {
        'Id': cid, 'Name': name, 'Created': store_mod.now(), 'Image': image_id, 'ImageName': image_text,
        'Config': {'Hostname': a.hostname or cid[:12], 'User': a.user if a.user is not None else config.get('User', ''),
                   'Env': env, 'Entrypoint': entrypoint, 'Cmd': cmd,
                   'WorkingDir': a.workdir or config.get('WorkingDir') or '',
                   'Labels': labels, 'Tty': a.tty, 'OpenStdin': a.interactive,
                   'StopSignal': a.stop_signal or config.get('StopSignal') or 'SIGTERM',
                   'StopTimeout': a.stop_timeout, 'ExposedPorts': config.get('ExposedPorts') or {},
                   'Volumes': config.get('Volumes') or {}},
        'HostConfig': {'Binds': binds, 'AutoRemove': a.rm, 'ReadonlyRootfs': a.read_only,
                       'InPlace': a.in_place, 'Isolate': a.isolate, 'IsolateDevices': a.isolate_device,
                       'Owners': a.owners, 'Cow': a.cow,
                       'RestartPolicy': restart, 'Tmpfs': tmpfs, 'ExtraHosts': hosts, 'Dns': a.dns,
                       'PortBindings': publish},
        'State': {'Status': 'created', 'Running': False, 'Pid': 0, 'ExitCode': 0,
                  'StartedAt': None, 'FinishedAt': None, 'RestartCount': 0},
    }
    network.attach_new(st, record, a.network, a.network_alias, a.ip)
    return record


ADJECTIVES = 'brave calm eager fancy gentle happy jolly keen lucid merry nifty proud quirky sharp tender vivid witty zen'.split()
NOUNS = 'archimedes babbage curie darwin euler fermat galois hopper johnson kepler lovelace noether pascal ritchie shannon turing wozniak yalow'.split()


def random_name(st):
    import secrets
    taken = {c['Name'] for c in st.containers()}
    while True:
        name = f'{secrets.choice(ADJECTIVES)}_{secrets.choice(NOUNS)}'
        if name not in taken:
            return name


