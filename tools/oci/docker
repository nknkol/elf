def main(argv):
    while argv and argv[0] in ('--debug', '-D'):
        argv = argv[1:]
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__.strip() + '\n\nCommands:\n  ' + ' '.join(sorted(COMMANDS)))
        return 0
    if argv[0] in ('-v', '--version'):
        argv = ['version']
    name, rest = argv[0], argv[1:]
    try:
        st = store_mod.Store()
        if name == '__monitor':
            runtime.monitor(st, rest[0])
            return 0
        if name not in COMMANDS:
            raise Fail(f"docker: '{name}' is not a docker command.\nSee 'docker --help'")
        return COMMANDS[name](st, rest) or 0
    except Fail as e:
        print(f'docker: {e}' if not str(e).startswith('docker') else str(e), file=sys.stderr)
        return e.code
    except SystemExit as e:   # --help
        return e.code or 0
    except ERRORS as e:
        print(f'docker: Error response from daemon: {e}', file=sys.stderr)
        return 125
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
